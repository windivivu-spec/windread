NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Recommended for new Supabase projects. Falls back to the anon key above for compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Set a high-entropy, one-time token before visiting /admin/setup to create the first Admin.
# Remove or rotate it after initial setup. Never expose this secret in NEXT_PUBLIC_ variables.
WINDREAD_ADMIN_SETUP_TOKEN=

GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_FROM_SERVICE_ACCOUNT_JSON_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_TIME_ZONE=Asia/Ho_Chi_Minh

BREVO_API_KEY=
BOOKING_EMAIL_FROM=Windread Booking <booking@your-domain.com>
BOOKING_EMAIL_REPLY_TO=

# Facebook Page Messenger webhook
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Chat provider
# conversational_agents uses eligible Conversational Agents / Playbooks credits.
# vertex_gemini calls Gemini directly and is billed as Vertex AI generative AI usage.
GOOGLE_CHAT_PROVIDER=vertex_gemini

# Conversational Agents / Playbooks (recommended for the Gen App Builder trial credit)
GOOGLE_CONVERSATIONAL_AGENT_ID=
GOOGLE_CONVERSATIONAL_AGENT_LOCATION=global
# Set this after publishing a production version/environment. Leave empty for Draft during setup.
GOOGLE_CONVERSATIONAL_AGENT_ENVIRONMENT_ID=

# Direct Vertex AI / Gemini (only used when GOOGLE_CHAT_PROVIDER=vertex_gemini)
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_MODEL=gemini-3.1-flash-lite

# Optional alternative: standard Vertex AI with a Google Cloud project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Paste the complete service-account JSON as one line. Never prefix this with NEXT_PUBLIC_.
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
